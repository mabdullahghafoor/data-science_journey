-- Sort results

SELECT * FROM orders        -- highest to lowest
ORDER BY amount DESC;

SELECT * FROM customers            -- youngest to oldest (ASC is default)
ORDER BY age ASC;


-- Sort by multiple columns

SELECT * FROM orders
ORDER BY status ASC, amount DESC;

-- sorts alphabetically by status first,
-- then within each status sorts by amount descending



-- Limit the number of rows returned

SELECT * FROM  orders                       -- top 3 most expensive orders
ORDER BY amount DESC
LIMIT 3;


-- OFFSET — skip rows (used for pagination)

SELECT  * FROM customers             -- rows 6 through 10
ORDER BY age ASC
LIMIT 5
OFFSET 5;
