    "# Missing value summary\n",
    "missing = pd.DataFrame({\n",
    "    \"missing_count\": df.isnull().sum(),\n",
    "    \"missing_percent\": (df.isnull().sum() / len(df) * 100).round(2)\n",
    "})\n",
    "missing[missing[\"missing_count\"] > 0]"
   ]
  },
