-- Single condition

SELECT  * FROM customers WHERE city = 'Karachi';

SELECT * FROM orders WHERE amount < 50000;

SELECT * FROM orders WHERE status = 'delivered';



-- Multiple conditions

SELECT * FROM customers WHERE city = 'Karachi' AND age < 30;

SELECT * FROM orders WHERE staus = 'delivered' OR status = 'pending'; 



-- NOT

SELECT * FROM orders WHERE NOT status = 'returned';



-- IN — cleaner alternative to multiple ORs

SELEECT * FROM customers WHERE city IN ('Karaachi'  ,  'Lahore'),



-- BETWEEN — inclusive on both ends

SELECT * FROM customers WHERE age between 25 AND 35;



