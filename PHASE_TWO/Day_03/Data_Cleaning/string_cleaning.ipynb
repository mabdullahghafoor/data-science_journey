   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "url = \"https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv\"\n",
    "\n",
    "df = pd.read_csv(url)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "481e52aa",
   "metadata": {},
   "source": [
    "# Create a messy example"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "09c63bda",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"city\"] = [\" Karachi\" , \"LAHORE\" , \"Islamabad\" , \"karachi\" , \"lahore\"]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c4f9b608",
   "metadata": {},
   "source": [
    "# Strip whitespace"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7e691447",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"city\"] = df[\"city\"].str.strip()\n",
    "# removes leading and trailing spaces\n",
    "df[\"city\"] = df[\"city\"].str.lstrip()     \n",
    "# leading only\n",
    "df[\"city\"] = df[\"city\"].str.rstrip()\n",
    "# trailing only"
   ]
