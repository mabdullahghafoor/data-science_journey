{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "4d586a9d",
   "metadata": {},
   "source": [
    "Use concat when you want to stack DataFrames on top of each other (more rows) or side by side (more columns)."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e76240aa",
   "metadata": {},
   "source": [
    "# Basic Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "3933d7e1",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "url = \"https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv\"\n",
    "df = pd.read_csv(url)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bbd8f2a3",
   "metadata": {},
   "source": [
    "# Data Frames"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "dcc5b470",
   "metadata": {},
   "outputs": [],
   "source": [
    "batch1 = pd.DataFrame({\n",
    "    \"name\" : [\"Ali\" , \"Zara\"],\n",
    "    \"score\" : [78, 88]\n",
    "})\n",
    "\n",
    "batch2 = pd.DataFrame({\n",
    "    \"name\" : [\"Ahmad\" , \"Riya\"],\n",
    "    \"score\" : [75, 83]\n",
    "})"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4702017b",
   "metadata": {},
   "source": [
    "# Pd.Concat"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "11a7a3f4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "    name  score\n",
      "0    Ali     78\n",
      "1   Zara     88\n",
      "2  Ahmad     75\n",
      "3   Riya     83\n"
     ]
    }
   ],
   "source": [
    "combined = pd.concat([batch1 , batch2] , ignore_index=True)\n",
    "print(combined)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "506ffce3",
   "metadata": {},
   "source": [
    "ignore_index=True resets the index cleanly\n",
    "Without it, you'd get index [0,1,0,1] which causes problems"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7933aac2",
   "metadata": {},
   "source": [
    "# Stack columns (axis=1) — DataFrames must have same number of rows"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "ae8b3d2c",
   "metadata": {},
   "outputs": [],
   "source": [
    "info = pd.DataFrame({\n",
    "    \"name\" : [\"Ali\" , \"Sara\"]\n",
    "})\n",
    "\n",
    "scores = pd.DataFrame({\n",
    "    \"maths\" : [78,80],\n",
    "    \"eng\" : [65 , 80]\n",
    "})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "33a9dc78",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/html": [
