   "source": [
    "# IQR method — the standard statistical approach"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7b5f9e26",
   "metadata": {},
   "outputs": [],
   "source": [
    "Q1 = df[\"Fare\"].quantile(0.25)\n",
    "Q3 = df[\"Fare\"].quantile(0.75)\n",
    "IQR = Q3 - Q1\n",
    "\n",
    "lower = Q1 - 1.5 * IQR\n",
    "upper  = Q3 + 1.25 * IQR"
   ]
