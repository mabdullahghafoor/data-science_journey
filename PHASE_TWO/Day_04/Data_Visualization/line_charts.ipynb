   "source": [
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "url = \"https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv\"\n",
    "\n",
    "df = pd.read_csv(url)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "243048a2",
   "metadata": {},
   "source": [
    "# Question: how does average fare change across passenger classes?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "cb06747e",
   "metadata": {},
   "outputs": [],
   "source": [
    "class_fare = df.groupby(\"Pclass\")[\"Fare\"].mean()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4675f199",
   "metadata": {},
