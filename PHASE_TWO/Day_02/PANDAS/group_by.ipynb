  },
  {
   "cell_type": "markdown",
   "id": "f5eabd0a",
   "metadata": {},
   "source": [
    "The pattern is always: df.groupby(\"GROUP_COLUMN\")[\"TARGET_COLUMN\"].function()"
   ]
