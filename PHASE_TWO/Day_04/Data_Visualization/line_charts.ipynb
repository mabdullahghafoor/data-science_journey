   "source": [
    "# Basic Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "33fbe428",
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "url = \"https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv\"\n",
    "\n",
    "df = pd.read_csv(url)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "243048a2",
   "metadata": {},
   "source": [
    "# Question: how does average fare change across passenger classes?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "cb06747e",
   "metadata": {},
   "outputs": [],
   "source": [
    "class_fare = df.groupby(\"Pclass\")[\"Fare\"].mean()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4675f199",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<function matplotlib.pyplot.show(close=None, block=None)>"
      ]
     },
     "execution_count": 6,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig , ax = plt.subplots(figsize=(8,5))\n",
    "\n",
    "ax.plot(class_fare.index, class_fare.values,\n",
    "        marker=\"o\",           # dot at each point\n",
    "        linewidth=2,\n",
    "        color=\"#2196F3\",\n",
    "        markersize=8)\n",
    "plt.show"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0543d4f9",
   "metadata": {},
   "source": [
    "# Every chart needs these four things"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "7e682430",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<function matplotlib.pyplot.show(close=None, block=None)>"
      ]
     },
     "execution_count": 8,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig, ax = plt.subplots(figsize=(8,5))\n",
    "\n",
    "ax.plot(class_fare.index , class_fare.values,\n",
    "        marker=\"o\",\n",
    "        linewidth=2,\n",
    "        color=\"#2196F3\",\n",
    "        markersize=8)\n",
    "\n",
    "# Every Chart NEeds These Four Things\n",
    "\n",
    "#1\n",
    "ax.set_title(\"Average Fare Drop Sharply From First To Third Class\",\n",
    "             fontsize=14, fontweight=\"bold\", pad=15)\n",
    "\n",
    "#2\n",
    "ax.set_xlabel(\"Passenger Class\" , fontsize=12)\n",
    "\n",
    "#3\n",
    "ax.set_ylabel(\"Average Fare (€)\" , fontsize=12)\n",
    "\n",
    "#4\n",
    "ax.set_xticks([1,2,3])\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7acc36fd",
   "metadata": {},
   "source": [
    "# Add value labels on each point"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "33424fae",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<function matplotlib.pyplot.show(close=None, block=None)>"
      ]
     },
     "execution_count": 10,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig , ax = plt.subplots(figsize=(8,5))\n",
    "\n",
    "ax.plot(class_fare.index , class_fare.values,\n",
    "        marker=\"o\",\n",
    "        linewidth=2,\n",
    "        color=\"#2196F3\",\n",
    "        markersize=8)\n",
    "\n",
    "# Four Things:\n",
    "\n",
    "ax.set_title(\"Average Fare Drop Sharply From Class One To Third\",\n",
    "             fontsize=16, fontweight=\"bold\" , pad=15)\n",
    "\n",
    "ax.set_xlabel(\"Passenger Class\" , fontsize=12)\n",
    "\n",
    "ax.set_ylabel(\"Average Fare (€)\" , fontsize=12)\n",
    "\n",
    "ax.set_xticks([1,2,3])\n",
    "\n",
    "# Add Value Labels\n",
    "\n",
    "for x , y in zip(class_fare.index , class_fare.values):\n",
    "\n",
    "    ax.annotate(f\"€ {y:.1f}\" , xy=(x , y), \n",
    "                xytext=(0 , 10) , textcoords=\"offset points\" , \n",
    "                ha=\"center\" , fontsize=10)\n",
    "\n",
    "# Print\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1f4138eb",
   "metadata": {},
   "source": [
    "Notice the title. It says what the chart shows, not just what the data is. \"Average fare by class\" is a label. \"Average fare drops sharply from first to third class\" is an insight. Always write insight titles."
   ]
  }
 ],
