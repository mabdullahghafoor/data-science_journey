  {
   "cell_type": "markdown",
   "id": "a724bad8",
   "metadata": {},
   "source": [
    "# STRATEGY 4: FILL with mode \n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7424f4d9",
   "metadata": {},
   "source": [
    "Use when: categorical column with missing values"
   ]
  },
