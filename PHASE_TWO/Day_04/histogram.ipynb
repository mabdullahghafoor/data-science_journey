   ]
  },
  {
   "cell_type": "markdown",
   "id": "e619b12f",
   "metadata": {},
   "source": [
    "# Add vertical lines for mean and median"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "eccbde99",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig , ax = plt.subplots(figsize=(10,5))\n",
    "\n",
    "ax.hist(df[\"Age\"].dropna(),\n",
    "        bins = 30,\n",
    "        color=\"#5C6BC0\",\n",
    "        edgecolor=\"white\",\n",
    "        linewidth=0.5)\n",
    "\n",
    "ax.axvline(df[\"Age\"].mean(),   color=\"#E53935\", linewidth=2,\n",
    "           linestyle=\"--\", label=f\"Mean: {df['Age'].mean():.1f}\")\n",
    "ax.axvline(df[\"Age\"].median(), color=\"#43A047\", linewidth=2,\n",
    "           linestyle=\"--\", label=f\"Median: {df['Age'].median():.1f}\")\n",
    "\n",
    "\n",
    "ax.set_title(\"Passenger ages peak in the 20s — young adult majority\",\n",
    "             fontsize=14, fontweight=\"bold\")\n",
    "ax.set_xlabel(\"Age\")\n",
    "ax.set_ylabel(\"Number Of Passengers\")\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5257ff23",
   "metadata": {},
   "source": [
    "# Histograms show distribution"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "04aa6590",
   "metadata": {},
   "source": [
    " — skewed left, skewed right, or normal. Adding mean and median lines immediately reveals skew: if mean > median, the distribution pulls right (high outliers). This is the kind of observation you write as an insight in your notebook."
   ]
  }
