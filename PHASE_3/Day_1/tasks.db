Task 1 — SELECT and WHERE
Find all customers from Karachi who are younger than 30. 
Show only their name and age.

SELECT
    name,
    city
FROM customers 
WHERE city = 'Karachi' AND age < 30;



Task 2 — ORDER BY and LIMIT
Find the top 3 most expensive delivered orders. 
Show order ID, customer ID, product, and amount.

SELECT
    order_id,
    customer_id,
    product,
    amount
FROM orders
ORDER BY amount DESC
LIMIT 3;



Task 3 — Aggregates
Find the total revenue, average order value, and number of orders 
for each product. 
Sort by total revenue descending.

SELECT 
    product,
    SUM(amount) AS total_revenue;
    ROUND(AV(amount),2) AS average_order_value,
    COUNT(order_id) AS no_of_orders
FROM orders
GROUP BY product
ORDER BY totaal_revenue DESC;



Task 4 — GROUP BY and HAVING
Find all customers who have placed more than one order 
and spent more than 100,000 in total. 
Show customer ID, order count, and total spent.

SELECT
    customer_id,
    COUNT(customer_id) AS order_count,
    SUM(amount) As total_spent
FROM orders
GROUP BY customer_id
HAVING order_count > 1 AND total_spent > 100000;



Task 5 — JOIN
Write a query that shows each customer's name, city, 
the product they ordered, the amount, and the order status. 
Only include delivered orders.

SELECT
    c.name,
    c.city,
    o.product,
    o.amount,
    o.status
FROM orders o
INNER JOIN customers c ON o.customer_id = c.customer_id
WHERE o.status = 'delivered';



Task 6 — Three-table JOIN
Using all three tables, find the profit (amount minus cost_price) 
for each delivered order. 
Show customer name, product, amount, cost price, and profit. 
Sort by profit descending.

SELECT
    c.name,
    o.product,
    o.amount,
    p.cost_price,
    o.amount - p.cost_price AS profit
FROM orders o
INNER JOIN customers c ON o.customer_id = c.customer_id
LEFT JOIN products p ON o.product = p.product
WHERE status = 'delivered'
ORDER BY profit DESC;



Task 7 — Subquery
Find the names of customers who have never placed an order.

SELECT
    name,
    city
FROM customers 
WHERE customer_id NOT IN (SELECT DISTINCT customer_id FROM orders);
