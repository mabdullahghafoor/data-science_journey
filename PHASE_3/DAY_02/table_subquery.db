-- returns a table, used in FROM



-- Average spending per customer, then average of that

SELECT
    ROUND(AVG(customer_total),2) AS  avg_customer_spend
FROM
    (SELECT
        customer_id,
        SUM(amount) as customer_total
    FROM orders 
    GROUP BY customer_id)
AS customer_spending;



-- The inner query produces a temporary table
-- The outer query treats it like a real table



-- Rank customers by spending, show top 2 per city

SELECT *
FROM (
    SELECT
        c.name,
        c.city,
        SUM(o.amount) AS total_spent
    FROM orders o
    JOIN customers c ON o.customer_id = c.customer_id
    GROUP BY  c.name , c.city
)
AS spending
ORDER BY city, total_spent DESC;
