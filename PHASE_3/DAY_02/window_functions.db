-- Regular aggregation collapses rows into groups

SELECT city, COUNT(*) FROM customers GROUP BY city;

-- Returns one row per city




-- Window function keeps all rows AND adds the aggregate

SELECT
    name,
    city,
    COUNT(*) OVER (PARTITION BY city) AS customers_in_same_city
FROM customers;

-- Returns all 7 rows, each showing how many total customers share their city
-- Ali    Karachi    3
-- Ahmed  Karachi    3
-- Hira   Karachi    3
-- Sara   Lahore     2
-- Bilal  Lahore     2
-- Zara   Islamabad  2
-- Usman  Islamabad  2



-- ROW_NUMBER — rank rows within a group

SELECT
    name,
    city,
    amount,
    ROW_NUMBER() OVER (PARTITION BY city ORDER BY amount DESC) AS rank_in_city
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id;




-- Running total (cumulative sum)

SELECT
    order_id,
    order_date,
    amount,
    SUM(amount) OVER (ORDER BY order_date) AS running_total
FROM orders
ORDER BY order_date;




-- RANK vs ROW_NUMBER vs DENSE_RANK


-- ROW_NUMBER: 1, 2, 3, 4  (no ties, always unique)

-- RANK:       1, 2, 2, 4  (ties get same rank, gap after ties)

-- DENSE_RANK: 1, 2, 2, 3  (ties get same rank, no gap)



Interview question you will get: 
"What is the difference between GROUP BY and window functions?"


Your answer: 

"GROUP BY collapses multiple rows into a single row per group. 
Window functions perform the same calculations 
but keep every row in the result 
— they add the aggregated value as a new column without reducing 
the number of rows. 
This is useful when you want to see both the individual row data 
and the group-level aggregation together."
