       "  <tbody>\n",
       "    <tr>\n",
       "      <th>female</th>\n",
       "      <td>27.915709</td>\n",
       "      <td>44.479818</td>\n",
       "      <td>314</td>\n",
       "      <td>0.742038</td>\n",
       "    </tr>\n",
       "    <tr>\n",
       "      <th>male</th>\n",
       "      <td>30.726645</td>\n",
       "      <td>25.523893</td>\n",
       "      <td>577</td>\n",
       "      <td>0.188908</td>\n",
       "    </tr>\n",
       "  </tbody>\n",
       "</table>\n",
       "</div>"
      ],
      "text/plain": [
       "          avg_age   avg_fare  no_of_passengers  survival_rate\n",
       "Sex                                                          \n",
       "female  27.915709  44.479818               314       0.742038\n",
       "male    30.726645  25.523893               577       0.188908"
      ]
     },
     "execution_count": 6,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "df.groupby(\"Sex\").agg(\n",
    "    avg_age = (\"Age\" , \"mean\"),\n",
    "    avg_fare = (\"Fare\" , \"mean\"),\n",
    "    no_of_passengers = (\"PassengerId\" , \"count\"),\n",
    "    survival_rate = (\"Survived\" , \"mean\")\n",
    ")"
   ]
  },
