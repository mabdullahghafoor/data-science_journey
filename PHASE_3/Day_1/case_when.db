-- Categorize orders by value

SELECT
    order_id,
    amount,
    CASE
        WHEN amount >= 80000 THEN 'High value'
        WHEN amount >= 40000 THEN 'Mid value'
        ELSE 'Low value'
    END AS order_tier
FROM orders;





-- Categorize customers by age group

SELECT
    name,
    age,
    CASE
        WHEN age < 25 THEN 'Young'
        WHEN age BETWEEN 25 AND 35 THEN 'Mid'
        ELSE 'Senior'
    END AS age_group
FROM customers;




