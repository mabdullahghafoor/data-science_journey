-- Returns exactly one number, used anywhere a single value is expected



-- Orders above the average amount

SELECT
    order_id,
    customer_id,
    product
FROM orders
WHERE amount > (SELECT DISTINCT AVG(amount) FROM orders);



-- Each order compared to overall average in one query

SELECT
    customer_id,
    order_id,
    product,
    amount,
    (SELECT AVG(amount) FROM ORDERS) AS overall_avg,
    amount - (SELECT AVG(amount) FROM orders) AS diff_from_avg
FROM orders
ORDER BY diff_from_avg DESC;