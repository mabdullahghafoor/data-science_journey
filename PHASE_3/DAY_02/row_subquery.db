--returns a list, used with IN / NOT IN



-- Customers who have ordered a Laptop

SELECT
    name,
    city
FROM customers
WHERE customer_id IN (
    SELECT DISTINCT
        customer_id
    FROM orders
    WHERE product = 'Laptop'
);



-- Customers who have ONLY placed delivered orders
-- (no returned, no pending)

SELECT 
    name
FROM customers
WHERE customer_id NOT IN
(SELECT DISTINCT 
    customer_id 
FROM orders 
WHERE status != 'delivered')
AND
customer_id IN
(SELECT DISTINCT 
    customer_id 
FROM orders);


