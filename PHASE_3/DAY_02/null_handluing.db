-- NULL is not equal to anything, including itself


-- This NEVER works:

SELECT * FROM orders WHERE amount = NULL;    -- always returns 0 rows



-- This is correct:


SELECT * FROM orders WHERE amount IS NULL;
SELECT * FROM orders WHERE amount IS NOT NULL;



-- COALESCE — return first non-null value


-- The most useful NULL function in SQL

SELECT
    order_id,
    COALESCE(amount, 0) AS amount        -- replace NULL with 0
FROM orders;



SELECT
    name,
    COALESCE(city, 'Unknown') AS city    -- replace NULL with 'Unknown'
FROM customers;



-- COALESCE with multiple fallbacks

SELECT COALESCE(NULL, NULL, 'third', 'fourth');  -- returns 'third'




-- NULLIF — return NULL if two values are equal (avoids division by zero)

SELECT
    product,
    SUM(amount) / NULLIF(COUNT(*), 0) AS avg_amount
FROM orders
GROUP BY product;

-- If COUNT(*) = 0, NULLIF returns NULL instead of dividing by zero



-- COUNT behavior with NULLs — important interview topic

SELECT
    COUNT(*)      AS total_rows,         -- counts everything including NULLs
    COUNT(amount) AS non_null_amounts    -- skips NULLs
FROM orders;

-- If these two numbers differ, you have NULLs in that column



Interview question you will get: 
"What is the difference between COUNT() and COUNT(column)?"*

Your answer: 
"COUNT() counts all rows including those with NULL values. 
COUNT(column) counts only the rows where that specific column is not NULL.
If the two numbers differ, 
it tells you exactly how many NULLs exist in that column."*



