      ]
     },
     "execution_count": 14,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "pd.concat([info , scores] , axis=1)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8fa640f1",
   "metadata": {},
   "source": [
    "merge vs concat: Use merge when combining on a shared key column (like SQL). Use concat when simply stacking DataFrames that have the same structure.\n",
    "\n"
   ]
  }
 ],
