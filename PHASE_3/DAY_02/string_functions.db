-- Length

SELECT name, LENGTH(name) AS name_length FROM customers;



-- Case

SELECT UPPER(name), LOWER(city) FROM customers;



-- Trim whitespace

SELECT TRIM('  Ali Khan  ');          -- 'Ali Khan'

SELECT LTRIM('  Ali'), RTRIM('Ali  ');



-- Substring

SELECT SUBSTR(name, 1, 3) FROM customers;   -- first 3 characters

-- SUBSTR(string, start_position, length)



