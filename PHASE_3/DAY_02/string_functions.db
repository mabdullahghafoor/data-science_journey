-- Length

SELECT name, LENGTH(name) AS name_length FROM customers;



-- Case

SELECT UPPER(name), LOWER(city) FROM customers;



-- Trim whitespace

SELECT TRIM('  Ali Khan  ');          -- 'Ali Khan'

SELECT LTRIM('  Ali'), RTRIM('Ali  ');



-- Substring

SELECT SUBSTR(name, 1, 3) FROM customers;   -- first 3 characters

-- SUBSTR(string, start_position, length)



-- Replace

SELECT REPLACE(city, 'Karachi', 'KHI') FROM customers;



-- Concatenation

SELECT name || ' from ' || city AS description FROM customers;

-- In MySQL: CONCAT(name, ' from ', city)



-- Find position of substring

SELECT INSTR(name, 'Khan') FROM customers;  -- 0 if not found





