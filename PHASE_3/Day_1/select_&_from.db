-- Get everything from the table

SELECT * FROM customers;
SELECT * FROM orders;
SELECT * FROM products;

-- Get specific columns only

SELECT name, city FROM customers;
SELECT order_id,amount FROM orders;
SELECT product,cost_price FROM products;

-- Give columns readable aliases

SELECT name AS customer_name,
       city AS location
FROM customers;

SELECT order_is AS order_no,
       amount AS price
FROM orders;

SELECT product AS item,
       category AS department
FROM products;

-- Select a calculated value

SELECT name,
       city,
       age,
       age + 5 AS age_in_five_years
FROM customers;


SELECT order_id,
       amount AS actual_price,
       amount - (amount / 100) * 10 AS discounted_price
FROM orders;
