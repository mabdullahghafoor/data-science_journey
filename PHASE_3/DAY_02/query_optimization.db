-- Select only the columns you need


-- BAD

SELECT * FROM orders JOIN customers ON ...;


-- GOOD

SELECT o.order_id, o.amount, c.name FROM orders o JOIN customers c ON ...;



-- Filter early with WHERE before joining when possible


-- BAD

SELECT * FROM orders o JOIN customers c ON o.customer_id = c.customer_id
WHERE o.status = 'delivered';


-- GOOD — same result, but filtering first reduces the join size

SELECT * FROM (
    SELECT * FROM orders WHERE status = 'delivered'
) o
JOIN customers c ON o.customer_id = c.customer_id;



