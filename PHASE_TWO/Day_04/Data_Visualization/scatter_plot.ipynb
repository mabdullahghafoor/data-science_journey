   "source": [
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "url = \"https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv\"\n",
    "\n",
    "df = pd.read_csv(url)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9f04e555",
   "metadata": {},
   "source": [
    "# Question: is there a relationship between age and fare?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "8c3b0752",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig , ax = plt.subplots(figsize=(10,6))\n",
    "\n",
    "\n",
    "# Color by survival status\n",
    "\n",
    "colors = df[\"Survived\"].map({0: \"#E53935\", 1: \"#43A047\"})\n",
    "\n",
    "scatteer = ax.scatter(df[\"Age\"], df[\"Fare\"],\n",
    "                      c=colors,\n",
    "                      alpha = 0.5,          # transparency — shows overlap\n",
    "                      s=40,                 # marker size\n",
    "                      edgecolor=\"none\")\n",
    "\n",
    "ax.set_title(\"High-fare passengers were more likely to survive\",\n",
    "             fontsize=14, fontweight =\"bold\")\n",
    "\n",
    "ax.set_xlabel(\"Age\")\n",
    "ax.set_ylabel(\"Fare Paid ($)\")\n",
    "\n",
    "# Manual legend\n",
    "from matplotlib.patches import Patch\n",
    "\n",
    "legend_elements = [Patch(facecolor=\"#43A047\", label=\"Survived\"),\n",
    "                   Patch(facecolor=\"#E53935\", label = \"Did not Survive\")]\n",
    "\n",
    "\n",
    "ax.legend(handles=legend_elements)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "\n"
   ]
  }
