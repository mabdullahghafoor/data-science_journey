This is where SQL becomes genuinely powerful. 
JOINs combine data from multiple tables based on a shared column — 
the same concept you learned with pd.merge() in Pandas.



-- INNER JOIN — only rows that match in BOTH tables

SELECT
    c.name,
    c.city,
    o.product,
    o.amount,
    o.status
FROM orders o
INNER JOIN customers c ON o.customer_id = c.customer_id;



-- Table aliases (o, c) make queries readable
-- ON specifies the matching condition


-- LEFT JOIN — all rows from left table (orders),
--             matched rows from right (customers), NULL where no match


SELECT
    o.order_id,
    o.amount,
    c.name,
    c.city
FROM orders o
LEFT JOIN customers c ON o.customer_id = c.customer_id;


-- Join three tables
