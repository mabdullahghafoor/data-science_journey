   "source": [
    "Merging combines two DataFrames based on a shared column — exactly like SQL JOINs."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "30a3d201",
   "metadata": {},
   "source": [
    "# Basic imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "cc8b098c",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "url = \"https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv\"\n",
    "df = pd.read_csv(url)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c493a34d",
   "metadata": {},
   "source": [
    "# Two small DataFrames to practice with"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "fc437d30",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   customer_id  name\n",
      "0            1   Ali\n",
      "1            2  Asif\n",
      "2            3   Ana\n",
      "3            4   Dia\n"
     ]
    }
   ],
   "source": [
    "customers = pd.DataFrame({\n",
    "    \"customer_id\" : [1 , 2 , 3 , 4],\n",
    "    \"name\" : [\"Ali\"  , \"Asif\" , \"Ana\" , \"Dia\"]\n",
    "})\n",
    "\n",
    "print(customers)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f48d1032",
   "metadata": {},
   "source": [
    "# Orders\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "244384a3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   order_id  customer_id  amount\n",
      "0       101            1     500\n",
      "1       102            2     650\n",
      "2       103            3     570\n",
      "3       104            4     600\n",
      "4       105            5     400\n"
     ]
    }
   ],
   "source": [
    "orders = pd.DataFrame({\n",
    "    \"order_id\" : [101 , 102 , 103 , 104 , 105],\n",
    "    \"customer_id\" : [1 , 2 , 3 , 4 , 5],\n",
    "    \"amount\" : [500 , 650 , 570, 600 , 400]\n",
    "})\n",
    "\n",
    "print(orders)"
   ]
  },
