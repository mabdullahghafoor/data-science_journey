   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "\n",
    "url = \"https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv\"\n",
    "\n",
    "df = pd.read_csv(url)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f62791a1",
   "metadata": {},
   "source": [
    "# Question: how does the age distribution differ between survivors and non-survivors?\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "1c1576c5",
   "metadata": {},
   "outputs": [
    {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig , ax = plt.subplots(figsize=(10,5))\n",
    "\n",
    "sns.histplot(\n",
    "    data=df,\n",
    "    x=\"Age\",\n",
    "    hue=\"Survived\",\n",
    "    kde = True,      # adds smooth curve\n",
    "    bins = 25,\n",
    "    palette = {0: \"#E53935\", 1: \"#43A047\"},\n",
    "    alpha = 0.6, \n",
    "    ax=ax\n",
    ")\n",
    "\n",
    "\n",
    "ax.set_title(\"Younger children survived at higher rates\",\n",
    "            fontsize=14, fontweight=\"bold\")\n",
    "\n",
    "ax.set_xlabel(\"Age\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  }
 ],
