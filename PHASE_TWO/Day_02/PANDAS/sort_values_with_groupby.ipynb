       "C    59.954144\n",
       "S    27.079812\n",
       "Q    13.276030\n",
       "Name: Fare, dtype: float64"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "df.groupby(\"Embarked\")[\"Fare\"].mean().sort_values(ascending=False)"
