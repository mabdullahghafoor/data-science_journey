-- COUNT

SELECT COUMT(*) FROM orders;         -- total rows

SELECT COUNT(*) FROM orders          -- count with condition
WHERE status = 'delivered';

SELECT COUNT(DISTINCT customer_id)   -- unique customers who ordered
FROM orders;


-- SUM

SELECT SUM(amount) FROM orders;       -- total revenue

SELECT SUM(amount) FROM orders        -- revenue from delivered only
WHERE status = 'delivered';


-- AVG

SELECT AVG(amount) FROM orders;       -- average order value

SELECT ROUND(AVG(amount),2)           -- rounded to 2 decimal places
FROM orders;
