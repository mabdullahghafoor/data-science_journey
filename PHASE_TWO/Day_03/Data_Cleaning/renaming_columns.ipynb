 "cells": [
  {
   "cell_type": "markdown",
   "id": "2b912346",
   "metadata": {},
   "source": [
    "# Basic Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "b5d9aa8d",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "url = \"https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv\"\n",
    "\n",
    "df = pd.read_csv(url)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ddd9d1c6",
   "metadata": {},
   "source": [
    "# Rename specific columns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "103ff7b6",
   "metadata": {},
   "outputs": [],
   "source": [
    "df.rename(columns={\n",
    "    \"PassengerId\" : \"Passenger_Id\",\n",
    "    \"Pclass\" : \"Passenger_class\",\n",
    "    \"SibSp\" : \"Sibilings_spouses\"\n",
    "} , inplace=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3499c4b8",
   "metadata": {},
   "source": [
    "# Clean all column names at once (lowercase + replace spaces with underscores)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "5ed645e0",
   "metadata": {},
   "outputs": [],
   "source": [
    "df.columns = df.columns.str.lower().str.replace(\" \" , \"_\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "43fab4dc",
   "metadata": {},
   "source": [
    "This turns \"First Name\", \"Last Name\", \"Date Of Birth\"\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "416d1170",
   "metadata": {},
   "source": [
    "Into \"first_name\", \"last_name\", \"date_of_birth\"\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bbfbe841",
   "metadata": {},
   "source": [
    "Always do this — column names with spaces are painful to work with"
   ]
  }
 ],
